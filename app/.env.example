# ---- App database (Neon Postgres) ----
# Pooled connection string for the running app/worker. Use the Neon *pooler*
# host for the app; the unpooled host is fine for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth.js ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"
# Public base URL of the site (used for OAuth callbacks + email links)
AUTH_URL="http://localhost:3000"
# Google OAuth (optional in dev — Credentials still works without it)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Pipeline → app ingest ----
# Shared secret the local Python pipeline sends in the X-Ingest-Token header.
INGEST_TOKEN="change-me-too"

# ---- Email (optional; dev logs to console when unset) ----
EMAIL_FROM="FP Fantasy <no-reply@example.com>"
RESEND_API_KEY=""
