# ---- SOURCE: local NFL_Data Postgres (READ-ONLY) ----
# Same values as NFL_Database_Guide/.env. Password required.
NFL_DB_HOST=localhost
NFL_DB_PORT=5432
NFL_DB_NAME=NFL_Data
NFL_DB_USER=postgres
NFL_DB_PASSWORD=

# ---- DEST: cloud app Postgres (Neon) ----
# Full connection string with TLS. Use a least-privilege writer role.
APP_DB_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
